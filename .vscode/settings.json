{
    "python.formatting.provider": "black",
    "cSpell.words": [
        "airpods",
        "astype",
        "backgroundcolor",
        "barh",
        "CMTE",
        "dask",
        "dataframe",
        "dropna",
        "dtype",
        "favourites",
        "figsize",
        "giscus",
        "Heavey",
        "iloc",
        "indiv",
        "isin",
        "kevinheavey",
        "linewidth",
        "matplotlib",
        "pyarrow",
        "pyplot",
        "seaborn",
        "subdir",
        "subplan",
        "timeseries",
        "vlines",
        "xlabel",
        "ylabel",
        "ylim"
    ],
    "cSpell.ignorePaths": [
        "package-lock.json",
        "node_modules",
        "vscode-extension",
        ".git/objects",
        ".vscode",
        ".vscode-insiders",
        "*.ipynb"
    ],
    "latex-workshop.latex.recipe.default": "first",
    "latex-workshop.latex.autoBuild.run": "never",
    "latex-workshop.latex.tools": [
        {
            "name": "latexmk-lualatex-cd",
            "command": "latexmk",
            "args": [
                "-gg",
                "-cd",
                "-lualatex",
                "-interaction=nonstopmode",
                "-synctex=1",
                "-file-line-error",
                "%DOC%"
            ]
        }
    ],
    "latex-workshop.latex.recipes": [
        {
            "name": "latexmk (LuaLaTeX from file dir)",
            "tools": [
                "latexmk-lualatex-cd"
            ]
        }
    ]
}
